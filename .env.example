# Pooled Neon PostgreSQL connection for the deployed application.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/neondb?sslmode=require"
# Non-pooled Neon connection used by Prisma CLI migrations and database tools.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require"

# Required for production authentication. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Optional OAuth providers. Leave unset to use credentials authentication only.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# DISCORD_CLIENT_ID=""
# DISCORD_CLIENT_SECRET=""

# Optional: enables Redis caching and rate limiting when both are set.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Required by the protected daily-generation cron endpoint in production.
# CRON_SECRET="replace-with-a-long-random-secret"
